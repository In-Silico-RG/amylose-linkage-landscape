integrator = md
dt = 0.002
nsteps = 50000
nstxout-compressed = 0
nstenergy = 5000
nstlog = 5000
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = Potential-shift
rvdw = 1.0
DispCorr = EnerPres
fourierspacing = 0.12
pme-order = 4
constraints = h-bonds
constraint-algorithm = lincs
tcoupl = V-rescale
tc-grps = System
tau-t = 1.0
ref-t = 303.15
comm-mode = linear
pcoupl = no
gen-vel = yes
gen-temp = 303.15
gen-seed = SEED
continuation = no
