integrator = md
dt = 0.002
nsteps = 50000000
nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 5000
compressed-x-grps = SUGAR
nstenergy = 5000
nstlog = 50000
nstcalcenergy = 100
cutoff-scheme = Verlet
nstlist = 20
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = Potential-shift
rvdw = 1.0
DispCorr = EnerPres
fourierspacing = 0.12
pme-order = 4
constraints = h-bonds
constraint-algorithm = lincs
tcoupl = V-rescale
tc-grps = System
tau-t = 1.0
ref-t = 303.15
comm-mode = linear
pcoupl = C-rescale
pcoupltype = isotropic
tau-p = 5.0
ref-p = 1.0
compressibility = 4.5e-5
continuation = yes
gen-vel = no
