; production mdp reconstructed from the 2025 production tpr (gmx dump), CHARMM36 settings
integrator              = md
dt                      = 0.002
nsteps                  = 50000000
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstxout-compressed      = 5000
nstenergy               = 5000
nstlog                  = 5000
nstcalcenergy           = 100
cutoff-scheme           = Verlet
nstlist                 = 20
verlet-buffer-tolerance = 0.005
coulombtype             = PME
rcoulomb                = 1.2
coulomb-modifier        = Potential-shift
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
DispCorr                = no
fourierspacing          = 0.12
pme-order               = 4
ewald-rtol              = 1e-5
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = 303.15
nsttcouple              = 100
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau-p                   = 5.0
compressibility         = 4.5e-5
ref-p                   = 1.0
nstpcouple              = 100
constraints             = none
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1
comm-mode               = linear
nstcomm                 = 100
continuation            = no
gen-vel                 = yes
gen-temp                = 303.15
gen-seed                = SEED
compressed-x-grps       = AGLC
